.SUBCKT CESR 1 2 PARAMS: C=10u ESR=2m ESL=510p IC=0
C1 1 INT1 {C} IC={IC}
R1 INT1 INT2 {ESR}
L1 INT2 2 {ESL}
.ENDS CESR
