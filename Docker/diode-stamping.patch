+
+/* Retain small device conductances when they are added to large coefficients.
+ * spSaveSystem includes this low part in the refinement residual. The element
+ * pointer returned by spGetElement addresses MatrixElement's first member. */
+void spAddReal(double *pointer, double increment)
+{
+    ElementPtr element = (ElementPtr)pointer;
+    double before = element->Real;
+    double sum = before + increment;
+    double delta = sum - before;
+    element->RealLow += (before - (sum - delta)) + (increment - delta);
+    element->Real = sum;
+}
