+        char *command;
+        eecircuit_wait_for_input();
+        command = eecircuit_get_input();
+        if (!command)
+            break;
+        cp_evloop(command);
+        free(command);
     }
 #endif /* defined(HAVE_GNUREADLINE) || defined(HAVE_BSDEDITLINE) */
 } /* end of function app_rl_readlines */
