diff --git a/src/main.c b/src/main.c
--- a/src/main.c
+++ b/src/main.c
@@ -6,6 +6,18 @@
 
    The main routine for ngspice
 */
+
+#include <emscripten.h>
+
+EM_ASYNC_JS(void, eecircuit_wait_for_input, (), {
+    if (Module["handleThings"])
+        await Module["handleThings"]();
+});
+
+EM_JS(char *, eecircuit_get_input, (), {
+    const command = Module["getInput"] ? Module["getInput"]() : null;
+    return command === null ? 0 : Module["stringToNewUTF8"](command);
+});
 
