+/* Predicate transitions are located only after a converged circuit solve.
+ * Search points stay provisional; rejected NR/LTE attempts discard the bracket. */
+typedef enum {
+    ASRC_ROOT_NONE, ASRC_ROOT_SEARCHING, ASRC_ROOT_LOCATED, ASRC_ROOT_COINCIDENT
+} ASRCrootState;
+
+enum { ASRC_EVENT_NORMAL, ASRC_EVENT_LOCATE, ASRC_EVENT_ACCEPT };
+
+typedef struct sASRCevent {
+    struct sASRCevent *next;
+    INPparseNode *node;
+    ASRCinstance *owner;
+    CKTcircuit *ckt;
+    void (*function)(void);
+    double time, argument, value, rootTime, coincidentValue;
+    double lo, hi, flo, fhi, wlo, whi;
+    int side;
+    ASRCrootState pending;
+    unsigned epoch, revision;
+    int valid;
+} ASRCevent;
+
+static double
+ASRCcomparison(double argument, void *data)
+{
+    ASRCevent *event = data;
+    CKTcircuit *ckt = event->ckt;
+    double value = PTunary(event->function)(argument);
+#ifdef XSPICE
+    double root, scale;
+    if (event->pending && event->revision != g_mif_info.analogStepRevision)
+        event->pending = ASRC_ROOT_NONE;
+    if (event->pending == ASRC_ROOT_COINCIDENT)
+        value = event->coincidentValue;
+    if (event->owner->ASRCeventMode == ASRC_EVENT_ACCEPT) {
+        if (event->epoch == event->owner->ASRCeventEpoch)
+            return value;
+        event->time = ckt->CKTtime;
+        event->argument = event->pending == ASRC_ROOT_COINCIDENT ||
+            (event->pending == ASRC_ROOT_LOCATED && event->rootTime == ckt->CKTtime) ? 0.0 : argument;
+        event->value = value;
+        event->valid = ckt->CKTtime > 0.0;
+        event->epoch = event->owner->ASRCeventEpoch;
+        event->pending = ASRC_ROOT_NONE;
+    } else if ((ckt->CKTmode & MODETRAN) && event->valid &&
+               event->epoch == event->owner->ASRCeventEpoch &&
+               ckt->CKTtime > event->time && isfinite(argument) &&
+               isfinite(event->argument)) {
+        /* During Newton recovery, solve the accepted side before locating a
+         * crossing. Let accepted roots and coincident events settle normally. */
+        if (g_mif_info.analogEventRetry &&
+            event->owner->ASRCeventMode == ASRC_EVENT_NORMAL &&
+            event->argument != 0.0 && event->pending != ASRC_ROOT_COINCIDENT)
+            value = event->value;
+        if (event->pending == ASRC_ROOT_LOCATED && event->rootTime == ckt->CKTtime)
+            value = event->value;
+        if (event->owner->ASRCeventMode == ASRC_EVENT_LOCATE) {
+            /* Another event can change the converged trajectory before this
+             * provisional root. Rebracket an already crossed predicate. */
+            if (g_mif_info.analogEventRetry && event->pending == ASRC_ROOT_LOCATED &&
+                ckt->CKTtime < event->rootTime && value != event->value)
+                event->pending = ASRC_ROOT_NONE;
+            if (!event->pending && event->argument != 0.0 &&
+                ((argument >= 0.0 && event->argument < 0.0) ||
+                 (argument <= 0.0 && event->argument > 0.0))) {
+                event->lo = event->time;
+                event->flo = event->argument;
+                event->hi = ckt->CKTtime;
+                event->fhi = argument;
+                event->wlo = event->flo;
+                event->whi = event->fhi;
+                event->side = 0;
+                event->revision = g_mif_info.analogStepRevision;
+                event->pending = ASRC_ROOT_SEARCHING;
+            }
+            if (event->pending == ASRC_ROOT_SEARCHING && ckt->CKTtime >= event->lo) {
+                if (ckt->CKTtime >= event->lo && ckt->CKTtime <= event->hi) {
+                    if ((argument > 0.0) == (event->flo > 0.0) && argument != 0.0) {
+                        if (ckt->CKTtime > event->lo) {
+                            event->whi = event->side == 1 ? event->whi * 0.5 : event->fhi;
+                            event->side = 1;
+                        }
+                        event->lo = ckt->CKTtime;
+                        event->flo = event->wlo = argument;
+                    } else {
+                        if (ckt->CKTtime < event->hi) {
+                            event->wlo = event->side == -1 ? event->wlo * 0.5 : event->flo;
+                            event->side = -1;
+                        }
+                        event->hi = ckt->CKTtime;
+                        event->fhi = event->whi = argument;
+                    }
+                }
+                /* Match the existing temporary-breakpoint spacing policy.
+                 * A whole bracket inside that interval is a coincident event. */
+                if (event->hi <= event->time + ckt->CKTminBreak) {
+                    event->pending = ASRC_ROOT_COINCIDENT;
+                    /* Keep the located side through the same-point retry. */
+                    event->coincidentValue = value;
+                    if (ckt->CKTorder != 1) {
+                        ckt->CKTnoncon++;
+                        g_mif_info.analogRetryTime = MIN(g_mif_info.analogRetryTime, ckt->CKTtime);
+                    }
+                    return value;
+                }
+                /* Illinois false position prevents a fixed-endpoint stall. */
+                scale = MAX(fabs(event->wlo), fabs(event->whi));
+                root = event->lo + (event->hi - event->lo) *
+                       ((fabs(event->wlo) / scale) /
+                        (fabs(event->wlo) / scale + fabs(event->whi) / scale));
+                if (event->fhi == 0.0 || event->hi - event->lo <= ckt->CKTminBreak ||
+                    nextafter(event->lo, event->hi) == event->hi)
+                    root = event->hi;
+                if (event->fhi == 0.0 ||
+                    event->hi - event->lo <= ckt->CKTminBreak ||
+                    nextafter(event->lo, event->hi) == event->hi) {
+                    event->rootTime = root;
+                    event->pending = ASRC_ROOT_LOCATED;
+                } else if (root <= event->lo || root >= event->hi) {
+                    root = event->lo + (event->hi - event->lo) * 0.5;
+                }
+                if (event->pending == ASRC_ROOT_SEARCHING &&
+                    root < event->time + ckt->CKTminBreak)
+                    root = event->time + ckt->CKTminBreak;
+                if (root != ckt->CKTtime)
+                    g_mif_info.analogRetryTime = MIN(g_mif_info.analogRetryTime, root);
+            }
+            if (event->pending == ASRC_ROOT_LOCATED) {
+                if (event->rootTime == ckt->CKTtime) {
+                    /* Integrate the left limit, then restart on the right. */
+                    value = event->value;
+                    g_mif_info.breakpoint.last = ckt->CKTtime;
+                    g_mif_info.analogRetryTime = MIN(g_mif_info.analogRetryTime, ckt->CKTtime);
+                } else if (event->rootTime < ckt->CKTtime) {
+                    g_mif_info.analogRetryTime = MIN(g_mif_info.analogRetryTime, event->rootTime);
+                } else if (event->rootTime > ckt->CKTtime + ckt->CKTminBreak) {
+                    g_mif_info.breakpoint.current = MIN(g_mif_info.breakpoint.current, event->rootTime);
+                }
+            }
+        }
+    }
+#endif
+    return value;
+}
+
+static int
+ASRCdiscontinuous(INPparseNode *node)
+{
+    if (!node)
+        return 0;
+    return (node->type == PT_FUNCTION && node->funcnum >= PTF_EQ0 &&
+            node->funcnum <= PTF_LE0) || ASRCdiscontinuous(node->left) ||
+            ASRCdiscontinuous(node->right);
+}
+
+static int
+ASRCeventTree(ASRCinstance *here, CKTcircuit *ckt, INPparseNode *node)
+{
+    ASRCevent *event;
+    int error;
+    if (!node)
+        return OK;
+    if (node->type == PT_FUNCTION && node->funcnum >= PTF_GT0 &&
+        node->funcnum <= PTF_LE0 && !node->data && !ASRCdiscontinuous(node->left)) {
+        event = TMALLOC(ASRCevent, 1);
+        if (!event)
+            return E_NOMEM;
+#ifdef XSPICE
+        g_mif_info.analogEventCount++;
+#endif
+        event->node = node;
+        event->owner = here;
+        event->ckt = ckt;
+        event->function = node->function;
+        event->next = here->ASRCevents;
+        here->ASRCevents = event;
+        node->function = (void (*)(void))ASRCcomparison;
+        node->data = event;
+    }
+    error = ASRCeventTree(here, ckt, node->left);
+    if (error)
+        return error;
+    return ASRCeventTree(here, ckt, node->right);
+}
+
+int
+ASRCeventSetup(ASRCinstance *here, CKTcircuit *ckt)
+{
+#ifdef XSPICE
+    return ASRCeventTree(here, ckt, ((INPparseTree *)here->ASRCtree)->tree);
+#else
+    return OK;
+#endif
+}
+
+void
+ASRCeventFree(ASRCinstance *here)
+{
+    ASRCevent *event = here->ASRCevents;
+    while (event) {
+        ASRCevent *next = event->next;
+        event->node->function = event->function;
+        event->node->data = NULL;
+#ifdef XSPICE
+        g_mif_info.analogEventCount--;
+#endif
+        FREE(event);
+        event = next;
+    }
+    here->ASRCevents = NULL;
+}
+
+int
+ASRCaccept(CKTcircuit *ckt, GENmodel *inModel)
+{
+    ASRCmodel *model = (ASRCmodel *)inModel;
+    ASRCinstance *here;
+    int i, error;
+    double value;
+    for (; model; model = ASRCnextModel(model)) {
+        for (here = ASRCinstances(model); here; here = ASRCnextInstance(here)) {
+            if (!here->ASRCevents)
+                continue;
+            i = here->ASRCtree->numVars;
+            if (asrc_nvals < i) {
+                asrc_nvals = i;
+                asrc_vals = TREALLOC(double, asrc_vals, i);
+                asrc_derivs = TREALLOC(double, asrc_derivs, i);
+            }
+            for (i = 0; i < here->ASRCtree->numVars; i++)
+                asrc_vals[i] = ckt->CKTrhsOld[here->ASRCvars[i]];
+            here->ASRCeventEpoch++;
+            here->ASRCeventMode = ASRC_EVENT_ACCEPT;
+            error = here->ASRCtree->IFeval(here->ASRCtree, ckt->CKTgmin,
+                                         &value, asrc_vals, NULL);
+            here->ASRCeventMode = ASRC_EVENT_NORMAL;
+            if (error)
+                return error;
+        }
+    }
+    return OK;
+}
+
+int
+ASRCtrunc(GENmodel *inModel, CKTcircuit *ckt, double *timeStep)
+{
+    ASRCmodel *model = (ASRCmodel *)inModel;
+    ASRCinstance *here;
+    int i, error;
+    double rhs, tolerance;
+    NG_IGNORE(timeStep);
+#ifdef XSPICE
+    g_mif_info.analogRetryTime = 1.0e30;
+#endif
+    for (; model; model = ASRCnextModel(model)) {
+        for (here = ASRCinstances(model); here; here = ASRCnextInstance(here)) {
+            if (!here->ASRCevents)
+                continue;
+            for (i = 0; i < here->ASRCtree->numVars; i++)
+                asrc_vals[i] = ckt->CKTrhs[here->ASRCvars[i]];
+            here->ASRCeventMode = ASRC_EVENT_LOCATE;
+            error = here->ASRCtree->IFeval(here->ASRCtree, ckt->CKTgmin,
+                                         &rhs, asrc_vals, NULL);
+            here->ASRCeventMode = ASRC_EVENT_NORMAL;
+            if (error)
+                return error;
+            tolerance = ckt->CKTreltol * MAX(fabs(rhs), fabs(here->ASRCprev_value)) +
+                (here->ASRCtype == ASRC_VOLTAGE ? ckt->CKTvoltTol : ckt->CKTabstol);
+            if (fabs(rhs - here->ASRCprev_value) > tolerance) {
+                ckt->CKTnoncon++;
+#ifdef XSPICE
+                if (g_mif_info.analogEventRetry)
+                    g_mif_info.analogRetryTime = MIN(g_mif_info.analogRetryTime, ckt->CKTtime);
+#endif
+            }
+        }
+    }
+    return OK;
+}
