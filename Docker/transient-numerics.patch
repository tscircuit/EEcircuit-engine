diff --git a/src/maths/sparse/sputils.c b/src/maths/sparse/sputils.c
--- a/src/maths/sparse/sputils.c
+++ b/src/maths/sparse/sputils.c
@@ -1,3 +1,6 @@
+#include "spproduct.h"
+#include <math.h>
+#include <string.h>
 /*
  *  MATRIX UTILITY MODULE
  *
@@ -2191,3 +2193,119 @@
     return;
 }
 #endif /* DOCUMENTATION */
+
+
+/* Preserve the unfactored system for compensated iterative refinement. */
+typedef struct {
+    int row, column;
+    double coefficient;
+} RefineEntry;
+
+typedef struct {
+    int size, count;
+    RefineEntry *entries;
+    double *vectors;
+} RefineSystem;
+
+void
+spFreeSystem(void *saved)
+{
+    RefineSystem *system = saved;
+    if (system) {
+        free(system->entries);
+        free(system->vectors);
+        free(system);
+    }
+}
+
+void *
+spSaveSystem(MatrixPtr matrix, double *rhs)
+{
+    RefineSystem *system = calloc(1, sizeof(*system));
+    ElementPtr element;
+    int column, count = 0;
+    if (!system)
+        return NULL;
+    /* The external numbering can contain gaps after circuit unsetup. */
+    system->size = spGetSize(matrix, 1);
+    for (column = 1; column <= matrix->Size; column++)
+        for (element = matrix->FirstInCol[column]; element; element = element->NextInCol)
+            if (element->Real != 0.0)
+                count++;
+    system->entries = calloc((size_t)count + 1, sizeof(*system->entries));
+    system->vectors = calloc((size_t)system->size + 1, 4 * sizeof(double));
+    if (!system->entries || !system->vectors) {
+        spFreeSystem(system);
+        return NULL;
+    }
+    memcpy(system->vectors, rhs, ((size_t)system->size + 1) * sizeof(double));
+    count = 0;
+    for (column = 1; column <= matrix->Size; column++) {
+        for (element = matrix->FirstInCol[column]; element; element = element->NextInCol) {
+            if (element->Real != 0.0) {
+                RefineEntry *entry = &system->entries[count++];
+                entry->row = matrix->IntToExtRowMap[element->Row];
+                entry->column = matrix->IntToExtColMap[column];
+                entry->coefficient = element->Real;
+            }
+        }
+    }
+    system->count = count;
+    return system;
+}
+
+void
+spRefineSystem(MatrixPtr matrix, void *saved, double *solution)
+{
+    RefineSystem *system = saved;
+    int n = system->size, iteration, i;
+    size_t bytes = ((size_t)n + 1) * sizeof(double);
+    double *residual = system->vectors + n + 1;
+    double *roundoff = residual + n + 1;
+    double *correction = roundoff + n + 1;
+    double previous = HUGE_VAL;
+
+    /* Reuse LU for at most five corrections, stopping when improvement stops.
+     * This improves the linear solve; all Newton and LTE checks still run. */
+    for (iteration = 0; iteration < 5; iteration++) {
+        double norm = 0.0;
+        int changed = 0;
+        memcpy(residual, system->vectors, bytes);
+        memset(roundoff, 0, bytes);
+        memset(correction, 0, bytes);
+        for (i = 0; i < system->count; i++) {
+            RefineEntry entry = system->entries[i];
+            double product = entry.coefficient * solution[entry.column];
+            double product_error = spProductError(entry.coefficient, solution[entry.column]);
+            double old = residual[entry.row], sum = old - product;
+            double delta = sum - old;
+            /* TwoSum plus the product residual retains cancellation error. */
+            roundoff[entry.row] += (old - (sum - delta)) + (-product - delta) - product_error;
+            residual[entry.row] = sum;
+        }
+        for (i = 1; i <= n; i++)
+            residual[i] += roundoff[i];
+        residual[0] = 0.0;
+        spSolve(matrix, residual, correction, NULL, NULL);
+        for (i = 1; i <= n; i++) {
+            double magnitude;
+            if (!isfinite(correction[i]))
+                return;
+            magnitude = fabs(correction[i]) / (1.0 + fabs(solution[i]));
+            if (magnitude > norm)
+                norm = magnitude;
+        }
+        if (norm >= previous)
+            break;
+        previous = norm;
+        for (i = 1; i <= n; i++) {
+            double corrected = solution[i] + correction[i];
+            if (!isfinite(corrected))
+                return;
+            changed |= corrected != solution[i];
+            solution[i] = corrected;
+        }
+        if (!changed)
+            break;
+    }
+}
