diff --git a/src/spicelib/analysis/dctran.c b/src/spicelib/analysis/dctran.c
--- a/src/spicelib/analysis/dctran.c
+++ b/src/spicelib/analysis/dctran.c
@@ -81,6 +81,7 @@
     double startTime;
     int startIters;
     int converged;
+    int lte_retry_can_advance = 0;
     int firsttime;
     int error;
 #ifdef WANT_SENSE2
@@ -713,6 +714,7 @@
         }
 #endif
         /* Central solver step */
+        lte_retry_can_advance = 0;
         converged = NIiter(ckt,ckt->CKTtranMaxIter);
 
         ckt->CKTstat->STATtimePts ++;
@@ -896,6 +898,12 @@
                 goto chkStep;  /* line 987 */
 #endif
             } else {
+                /* The default minimum is a heuristic based on maxStep. A
+                 * converged trial can request a smaller step through LTE.
+                 * Retry it if time can advance; all error checks still run. */
+                double retry_start = ckt->CKTtime - ckt->CKTdelta;
+                lte_retry_can_advance = isfinite(newdelta) && newdelta > 0.0 &&
+                    retry_start + newdelta > retry_start;
                 /* not (newdelta > .9 * ckt->CKTdelta): reject the step
                 - redo the time
                 - apply the new (reduced) delta */
@@ -919,7 +927,7 @@
         /* Set the new delta to delmin (minimum delta allowed). However:
            If the new delta has been less than the minimum delta
            for the second time, bail out with 'Timestep too small'. */
-        if (ckt->CKTdelta <= ckt->CKTdelmin
+        if (ckt->CKTdelta <= ckt->CKTdelmin && !lte_retry_can_advance
 #ifdef XSPICE
             /* A converged same-point event correction is not a timestep cut. */
             && !(xspice_breakpoints_processed && ckt->CKTdelta > 0.0 && ckt->CKTdelta == olddelta)
